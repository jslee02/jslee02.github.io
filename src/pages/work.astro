---
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
---

<BaseLayout
  title="Work"
  description="Selected robotics, physics simulation, digital human, and open-source work by Jeongseok Lee."
>
  <section class="page-hero section-shell">
    <p class="eyebrow">Selected work</p>
    <h1>Open-source systems, simulation infrastructure, and digital-human research.</h1>
    <p class="lead">
      A practical portfolio organized around public software and research-facing
      engineering work.
    </p>
  </section>

  <section class="section-shell">
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
