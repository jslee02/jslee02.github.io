---
import SoftwarePortfolio from "@/components/SoftwarePortfolio.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
  canonicalPath?: string;
}

const { locale = defaultLocale, canonicalPath = "/software/" } = Astro.props;
const page = getContent(locale).pages.software;
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath={canonicalPath}
>
  <SoftwarePortfolio locale={locale} />
</BaseLayout>
