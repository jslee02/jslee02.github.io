---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getContent(locale);
const page = content.pages.cv;
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath="/cv/"
>
  <section class="page-hero section-shell cv-hero">
    <div>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p class="lead">{page.lead}</p>
    </div>
    <a class="button primary" href="/cv/jeongseok-lee-cv.pdf">{page.download}</a>
  </section>

  <section class="section-shell timeline-section">
    <div class="section-heading">
      <p class="eyebrow">{page.experienceEyebrow}</p>
      <h2>{page.careerTitle}</h2>
    </div>
    <div class="timeline">
      {
        content.career.map((item) => (
          <article class="timeline-item">
            <div class="timeline-date">{item.period}</div>
            <div>
              <h3>{item.role}</h3>
              <p class="meta-line">
                {item.organization} · {item.location}
              </p>
              <ul class="compact-list">
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-shell two-column-lists">
    <div>
      <p class="eyebrow">{page.educationEyebrow}</p>
      <div class="stack-list">
        {
          content.education.map((item) => (
            <article class="plain-card">
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
              <p class="meta-line">{item.period}</p>
              <p>{item.note}</p>
            </article>
          ))
        }
      </div>
    </div>
    <div>
      <p class="eyebrow">{page.skillsEyebrow}</p>
      <div class="stack-list">
        {
          content.skills.map((group) => (
            <article class="plain-card">
              <h3>{group.group}</h3>
              <div class="tag-list">
                {group.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
