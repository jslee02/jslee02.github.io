---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getContent(locale);
const page = content.pages.contact;
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath="/contact/"
>
  <section class="page-hero section-shell contact-hero">
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.heading}</h1>
    <p class="lead">{page.lead}</p>
  </section>

  <section class="section-shell">
    <div class="contact-grid">
      {
        content.profile.links.map((link) => (
          <a class="contact-link" href={link.href}>
            <span>{link.label}</span>
            <strong>{link.href.replace("mailto:", "")}</strong>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
