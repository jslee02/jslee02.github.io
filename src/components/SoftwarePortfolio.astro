---
import ProjectCard from "@/components/ProjectCard.astro";
import ResourceCard from "@/components/ResourceCard.astro";
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
  id?: string;
}

const { locale = defaultLocale, id = "software" } = Astro.props;
const content = getContent(locale);
const page = content.pages.software;
---

<section id={id} class="section-shell content-section">
  <div class="section-intro">
    <p class="eyebrow">{page.eyebrow}</p>
    <h2>{page.heading}</h2>
    <p>{page.lead}</p>
  </div>
  <div class="project-list">
    {content.projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<section class="section-shell section-continuation">
  <div class="section-intro">
    <p class="eyebrow">{page.metaEyebrow}</p>
    <h2>{page.metaHeading}</h2>
    <p>{page.metaLead}</p>
  </div>
  <div class="resource-list">
    {content.metaProjects.map((item) => <ResourceCard item={item} />)}
  </div>
</section>

<section class="section-shell section-continuation">
  <div class="section-intro">
    <p class="eyebrow">{page.curatedEyebrow}</p>
    <h2>{page.curatedHeading}</h2>
    <p>{page.curatedLead}</p>
  </div>
  <div class="resource-list">
    {content.curatedLists.map((item) => <ResourceCard item={item} />)}
  </div>
</section>
