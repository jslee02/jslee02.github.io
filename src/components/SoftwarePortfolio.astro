---
import ProjectCard from "@/components/ProjectCard.astro";
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getContent(locale);
const page = content.pages.software;
---

<section class="page-hero section-shell">
  <p class="eyebrow">{page.eyebrow}</p>
  <h1>{page.heading}</h1>
  <p class="lead">{page.lead}</p>
</section>

<section class="section-shell">
  <div class="project-list">
    {content.projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
