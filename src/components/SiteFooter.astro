---
import { defaultLocale, getContent, type Locale } from "@/i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getContent(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>&copy; {year} Jeongseok Lee</p>
  <p>
    {content.common.footer}
    {" "}
    <a href="https://jeongseok.dev">jeongseok.dev</a>.
  </p>
</footer>
