---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/software/", label: "Software", aliases: ["/work/"] },
  { href: "/research/", label: "Research" },
  { href: "/cv/", label: "CV" },
  { href: "/contact/", label: "Contact" },
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Jeongseok Lee home">
    <span class="brand-mark">JL</span>
    <span>Jeongseok Lee</span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? pathname === "/"
            : pathname.startsWith(item.href) ||
              item.aliases?.some((alias) => pathname.startsWith(alias));
        return (
          <a href={item.href} aria-current={isActive ? "page" : undefined}>
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>
