---
import {
  basePathFromPathname,
  canonicalBasePath,
  defaultLocale,
  getContent,
  localizedPath,
  singlePagePath,
  type Locale,
} from "@/i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getContent(locale);
const navItems = content.nav;

const pathname = Astro.url.pathname;
const currentBasePath = canonicalBasePath(basePathFromPathname(pathname));
const alternateLocale: Locale = locale === "en" ? "ko" : "en";
const languageHref = singlePagePath(alternateLocale, currentBasePath);
const homeHref = localizedPath(locale, "/");
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label="Jeongseok Lee home">
    <span class="brand-mark">JL</span>
    <span>Jeongseok Lee</span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {
      navItems.map((item) => {
        const itemHref = singlePagePath(locale, item.href);
        const isActive = item.href === "/" && currentBasePath === "/";
        return (
          <a href={itemHref} aria-current={isActive ? "page" : undefined}>
            {item.label}
          </a>
        );
      })
    }
    <a class="language-switch" href={languageHref}>
      {content.common.languageSwitch}
    </a>
  </nav>
</header>
