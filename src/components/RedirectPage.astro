---
interface Props {
  target: string;
}

const { target } = Astro.props;
const canonical = new URL(target, "https://jeongseok.dev").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>Redirecting | Jeongseok Lee</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>Continue to Jeongseok Lee</a>
  </body>
</html>
